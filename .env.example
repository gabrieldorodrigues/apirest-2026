# Copie para .env e ajuste se quiser trocar as portas ou as credenciais do docker compose
POSTGRES_DB=musica
POSTGRES_USER=musica
POSTGRES_PASSWORD=musica
API_PORT=8080
DB_PORT=5432
# quantas instâncias da API ficam atrás do load balancer
API_REPLICAS=3
# imagem da API; troque por ghcr.io/gabrieldorodrigues/apirest-2026 para usar a publicada pelo CI
API_IMAGE=apirest-2026-musica
# tempo que um álbum fica no cache do Redis (ex.: 30s, 10m, 1h)
CACHE_TTL=10m
